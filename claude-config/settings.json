{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -s ~/.claude/CLAUDE.md ]; then echo '[Memory loaded] Long-term memory is active. Check ~/.claude/CLAUDE.md for context.'; fi",
                        "async": true
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/stop-hook-git-check.sh"
                    },
                    {
                        "type": "command",
                        "command": "~/.claude/dreaming.sh",
                        "async": true
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": ["Skill"]
    },
    "mcpServers": {
        "context7": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@upstash/context7-mcp@latest"]
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": ["@playwright/mcp@latest"]
        },
        "taskmaster": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "task-master-ai@latest"]
        },
        "container-use": {
            "type": "stdio",
            "command": "container-use",
            "args": ["stdio"]
        },
        "firecrawl": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "firecrawl-mcp"],
            "env": {
                "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
            }
        },
        "brave-search": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-brave-search"],
            "env": {
                "BRAVE_API_KEY": "${BRAVE_API_KEY}"
            }
        },
        "memory": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@mem0ai/mem0-mcp"],
            "env": {
                "MEM0_API_KEY": "${MEM0_API_KEY}"
            }
        },
        "exa": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "exa-mcp-server"],
            "env": {
                "EXA_API_KEY": "${EXA_API_KEY}"
            }
        }
    }
}
